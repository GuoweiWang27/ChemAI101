{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chemai101-api",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "UPSTREAM_URL": "https://api.vectorengine.ai/v1/chat/completions",
    "MODEL_NAME": "gemini-2.5-flash"
  },
  "secrets": {
    "required": ["VECTORENGINE_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2026082301",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
